# ==========================================
# Takweyat Foundation - Environment Variables Example
# ==========================================

# Secret key for Payload CMS sessions (generate a random 32+ char hex string)
PAYLOAD_SECRET=replace_with_your_payload_secret_key

# Database Connection:
# Option A - Local SQLite (default, zero configuration needed):
DATABASE_URL=file:./payload.db

# Option B - PostgreSQL (e.g. Supabase, Neon, AWS RDS, Dokploy Docker network):
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (Optional)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id_here
